@description "Read-only local and GitHub repository capabilities from github.com/nexssp/repo"

@description "Inspect a local Git worktree's root, branch, commit, remote, and status"
@pipeline inspect
  repo.inspect
@end

@description "Inspect GitHub metadata, default-branch head, latest tag/release, and CI/check status"
@pipeline github_inspect
  repo.github_inspect
@end

@description "Inspect a GitHub repository's latest tag without fetching commit or CI metadata"
@pipeline github_tags
  repo.github_tags
@end

@description "Validate and normalize a GitHub repository reference without network access"
@pipeline github_normalize
  repo.github_normalize
@end

@description "Find the highest Go-module-valid semantic-version tag in a GitHub repository"
@pipeline github_latest_semver
  repo.github_latest_semver
@end

@description "Compare a repository's go.mod versions with latest versions supplied by the caller"
@pipeline github_module_versions
  repo.github_module_versions
@end

@description "List tracked and non-ignored untracked files"
@pipeline files
  repo.files
@end

@description "Read the tracked-file diff; pass staged=true for staged changes only"
@pipeline diff
  repo.diff
@end

@description "Pack bounded text files for review or model context"
@pipeline pack
  repo.pack
@end

@description "Compare the local branch head and tags with a Git remote; read-only, reports pushed state"
@pipeline sync
  repo.sync
@end
